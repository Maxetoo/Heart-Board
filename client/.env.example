# The client talks to the API at the SAME ORIGIN via the relative path /api/v1.
# In dev, vite.config.ts proxies /api to the Express server; in production
# Express serves client/dist itself. So no API URL is needed here.
#
# Override the dev proxy target only if your API runs somewhere else:
# VITE_API_PROXY_TARGET=http://localhost:8080

# Escape hatch: point the client at a fully separate API origin. If you set
# this, the API must send sameSite=none; secure=true on the auth cookie.
# VITE_ORIGIN_URL=

# RevenueCat publishable key (safe to expose; it is a client key).
VITE_REVENUECAT_API_KEY=

# NEVER put GEMINI_API_KEY or any secret here. Everything VITE_* is public.
